<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.note4c-codex-quota.schedule</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/note4c-scheduled-sync.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/note4c-codex-quota-schedule.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/note4c-codex-quota-schedule.err</string>
</dict>
</plist>
