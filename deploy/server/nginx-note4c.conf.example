server {
    listen 80;
    listen [::]:80;
    server_name quota.example.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name quota.example.com;

    ssl_certificate /etc/letsencrypt/live/quota.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quota.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    auth_basic "NOTE4C Codex quota";
    auth_basic_user_file /etc/nginx/note4c.htpasswd;

    root /srv/note4c/public;

    location = / {
        add_header Cache-Control "no-store" always;
        try_files /index.html =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location = /preview.png {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location = /manifest.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /frames/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri =404;
    }
}
