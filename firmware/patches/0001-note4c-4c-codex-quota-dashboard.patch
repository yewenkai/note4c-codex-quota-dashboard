diff --git a/firmware/main/common/codex_quota_client.cc b/firmware/main/common/codex_quota_client.cc
new file mode 100644
index 0000000..8f18833
--- /dev/null
+++ b/firmware/main/common/codex_quota_client.cc
@@ -0,0 +1,328 @@
+#include "codex_quota_client.h"
+
+#include "common/photo_storage.h"
+#include "settings.h"
+
+#include <cJSON.h>
+#include <esp_crt_bundle.h>
+#include <esp_heap_caps.h>
+#include <esp_http_client.h>
+#include <esp_log.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <psa/crypto.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <functional>
+#include <string>
+
+namespace {
+
+constexpr char kTag[] = "CodexQuota";
+constexpr char kNamespace[] = "codex_dash";
+constexpr char kEnabledKey[] = "enabled";
+constexpr char kBaseUrlKey[] = "base_url";
+constexpr char kUsernameKey[] = "username";
+constexpr char kPasswordKey[] = "password";
+constexpr char kPollMinutesKey[] = "poll_min";
+constexpr char kRevisionKey[] = "revision";
+constexpr char kPhotoId[] = "codexquota";
+constexpr size_t kManifestCapacity = 3072;
+constexpr size_t kFrameSize = 400 * 300 / 4;
+
+std::atomic<bool> s_connected{false};
+std::atomic<bool> s_sync_requested{false};
+std::atomic<bool> s_started{false};
+std::function<void()> s_on_frame_ready;
+std::string s_session_revision;
+
+struct ClientConfig {
+    bool enabled = false;
+    std::string base_url;
+    std::string username;
+    std::string password;
+    int poll_minutes = 5;
+};
+
+struct HttpBuffer {
+    uint8_t* data = nullptr;
+    size_t capacity = 0;
+    size_t length = 0;
+    bool overflow = false;
+};
+
+struct Manifest {
+    std::string revision;
+    std::string path;
+    std::string sha256;
+    int64_t generated_at = 0;
+};
+
+ClientConfig LoadConfig() {
+    Settings nvs(kNamespace, false);
+    ClientConfig config;
+    config.enabled = nvs.GetBool(kEnabledKey, false);
+    config.base_url = nvs.GetString(kBaseUrlKey);
+    config.username = nvs.GetString(kUsernameKey, "note4c");
+    config.password = nvs.GetString(kPasswordKey);
+    config.poll_minutes = static_cast<int>(
+        std::clamp<int32_t>(nvs.GetInt(kPollMinutesKey, 5), 1, 60));
+    while (!config.base_url.empty() && config.base_url.back() == '/') {
+        config.base_url.pop_back();
+    }
+    return config;
+}
+
+bool IsSafeHttpsBaseUrl(const std::string& url) {
+    return url.rfind("https://", 0) == 0 && url.size() <= 255 && url.find_first_of("\r\n") == std::string::npos;
+}
+
+bool IsSafeFramePath(const std::string& path) {
+    if (path.rfind("frames/", 0) != 0 || path.find("..") != std::string::npos || path.size() > 96) {
+        return false;
+    }
+    return std::all_of(path.begin(), path.end(), [](unsigned char ch) {
+        return std::isalnum(ch) || ch == '/' || ch == '.' || ch == '-' || ch == '_';
+    });
+}
+
+bool IsSha256(const std::string& value) {
+    return value.size() == 64 && std::all_of(value.begin(), value.end(), [](unsigned char ch) {
+        return std::isdigit(ch) || (ch >= 'a' && ch <= 'f');
+    });
+}
+
+esp_err_t HttpEvent(esp_http_client_event_t* event) {
+    if (event->event_id != HTTP_EVENT_ON_DATA || event->data_len <= 0) return ESP_OK;
+    auto* buffer = static_cast<HttpBuffer*>(event->user_data);
+    if (!buffer || !buffer->data || buffer->length + event->data_len > buffer->capacity) {
+        if (buffer) buffer->overflow = true;
+        return ESP_FAIL;
+    }
+    memcpy(buffer->data + buffer->length, event->data, event->data_len);
+    buffer->length += event->data_len;
+    return ESP_OK;
+}
+
+bool HttpGet(const ClientConfig& dashboard, const std::string& url, HttpBuffer* output) {
+    if (!output || !output->data || output->capacity == 0) return false;
+    output->length = 0;
+    output->overflow = false;
+
+    esp_http_client_config_t config = {};
+    config.url = url.c_str();
+    config.method = HTTP_METHOD_GET;
+    config.event_handler = HttpEvent;
+    config.user_data = output;
+    config.username = dashboard.username.c_str();
+    config.password = dashboard.password.c_str();
+    config.auth_type = HTTP_AUTH_TYPE_BASIC;
+    config.timeout_ms = 15000;
+    config.disable_auto_redirect = false;
+    config.crt_bundle_attach = esp_crt_bundle_attach;
+
+    esp_http_client_handle_t client = esp_http_client_init(&config);
+    if (!client) {
+        ESP_LOGE(kTag, "Failed to initialize HTTPS client");
+        return false;
+    }
+    esp_err_t result = esp_http_client_perform(client);
+    const int status = esp_http_client_get_status_code(client);
+    esp_http_client_cleanup(client);
+    if (result != ESP_OK || status != 200 || output->overflow) {
+        ESP_LOGW(kTag, "GET failed: status=%d err=%s overflow=%d url=%s",
+                 status, esp_err_to_name(result), output->overflow ? 1 : 0, url.c_str());
+        return false;
+    }
+    return true;
+}
+
+bool ParseManifest(const uint8_t* data, size_t length, Manifest* manifest) {
+    if (!data || !manifest || length == 0 || length >= kManifestCapacity) return false;
+    std::string json(reinterpret_cast<const char*>(data), length);
+    cJSON* root = cJSON_ParseWithLength(json.c_str(), json.size());
+    if (!root) return false;
+
+    bool valid = false;
+    cJSON* schema = cJSON_GetObjectItemCaseSensitive(root, "schemaVersion");
+    cJSON* revision = cJSON_GetObjectItemCaseSensitive(root, "revision");
+    cJSON* generated_at = cJSON_GetObjectItemCaseSensitive(root, "generatedAt");
+    cJSON* frame = cJSON_GetObjectItemCaseSensitive(root, "frame");
+    cJSON* path = frame ? cJSON_GetObjectItemCaseSensitive(frame, "path") : nullptr;
+    cJSON* sha = frame ? cJSON_GetObjectItemCaseSensitive(frame, "sha256") : nullptr;
+    cJSON* size = frame ? cJSON_GetObjectItemCaseSensitive(frame, "size") : nullptr;
+    cJSON* format = frame ? cJSON_GetObjectItemCaseSensitive(frame, "format") : nullptr;
+    cJSON* width = frame ? cJSON_GetObjectItemCaseSensitive(frame, "width") : nullptr;
+    cJSON* height = frame ? cJSON_GetObjectItemCaseSensitive(frame, "height") : nullptr;
+
+    if (cJSON_IsNumber(schema) && schema->valueint == 1 &&
+        cJSON_IsString(revision) && revision->valuestring &&
+        cJSON_IsNumber(generated_at) &&
+        cJSON_IsString(path) && path->valuestring &&
+        cJSON_IsString(sha) && sha->valuestring &&
+        cJSON_IsNumber(size) && size->valueint == static_cast<int>(kFrameSize) &&
+        cJSON_IsString(format) && strcmp(format->valuestring, "bwry2bpp") == 0 &&
+        cJSON_IsNumber(width) && width->valueint == 400 &&
+        cJSON_IsNumber(height) && height->valueint == 300) {
+        manifest->revision = revision->valuestring;
+        manifest->path = path->valuestring;
+        manifest->sha256 = sha->valuestring;
+        manifest->generated_at = static_cast<int64_t>(generated_at->valuedouble);
+        valid = IsSha256(manifest->revision) && manifest->revision == manifest->sha256 &&
+                IsSafeFramePath(manifest->path) && manifest->generated_at > 0;
+    }
+    cJSON_Delete(root);
+    return valid;
+}
+
+std::string Sha256Hex(const uint8_t* bytes, size_t length) {
+    uint8_t digest[32] = {};
+    size_t digest_length = 0;
+    if (psa_crypto_init() != PSA_SUCCESS ||
+        psa_hash_compute(PSA_ALG_SHA_256, bytes, length, digest, sizeof(digest),
+                         &digest_length) != PSA_SUCCESS ||
+        digest_length != sizeof(digest)) {
+        return {};
+    }
+    char hex[65] = {};
+    for (size_t index = 0; index < sizeof(digest); ++index) {
+        snprintf(hex + index * 2, 3, "%02x", digest[index]);
+    }
+    return hex;
+}
+
+bool SaveFrame(const uint8_t* frame, const Manifest& manifest) {
+    PhotoInfo info = {};
+    strlcpy(info.id, kPhotoId, sizeof(info.id));
+    strlcpy(info.title, "Codex 三账号额度", sizeof(info.title));
+    info.width = 400;
+    info.height = 300;
+    info.file_size = kFrameSize;
+    info.timestamp = static_cast<uint32_t>(manifest.generated_at);
+
+    time_t timestamp = static_cast<time_t>(manifest.generated_at);
+    struct tm local = {};
+    localtime_r(&timestamp, &local);
+    strftime(info.date, sizeof(info.date), "%Y-%m-%d %H:%M", &local);
+    strlcpy(info.location, "Codex 配额中继", sizeof(info.location));
+    strlcpy(info.body, "Business / Plus 额度；失败时保留上一张图", sizeof(info.body));
+    return photo_save(&info, frame) == 0;
+}
+
+bool SyncOnce(const ClientConfig& config) {
+    uint8_t manifest_bytes[kManifestCapacity] = {};
+    HttpBuffer manifest_buffer{manifest_bytes, kManifestCapacity - 1, 0, false};
+    const std::string manifest_url = config.base_url + "/manifest.json";
+    if (!HttpGet(config, manifest_url, &manifest_buffer)) return false;
+
+    Manifest manifest;
+    if (!ParseManifest(manifest_bytes, manifest_buffer.length, &manifest)) {
+        ESP_LOGW(kTag, "Invalid relay manifest; keeping previous frame");
+        return false;
+    }
+
+    Settings current(kNamespace, false);
+    const std::string stored_revision = current.GetString(kRevisionKey);
+    if (stored_revision == manifest.revision && photo_exists(kPhotoId)) {
+        if (s_session_revision != manifest.revision) {
+            s_session_revision = manifest.revision;
+            if (s_on_frame_ready) s_on_frame_ready();
+        }
+        ESP_LOGI(kTag, "Manifest unchanged: %.12s", manifest.revision.c_str());
+        return true;
+    }
+
+    auto* frame = static_cast<uint8_t*>(
+        heap_caps_malloc(kFrameSize, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (!frame) frame = static_cast<uint8_t*>(malloc(kFrameSize));
+    if (!frame) {
+        ESP_LOGE(kTag, "Unable to allocate %u-byte frame", static_cast<unsigned>(kFrameSize));
+        return false;
+    }
+    HttpBuffer frame_buffer{frame, kFrameSize, 0, false};
+    const std::string frame_url = config.base_url + "/" + manifest.path;
+    bool success = HttpGet(config, frame_url, &frame_buffer) &&
+                   frame_buffer.length == kFrameSize &&
+                   Sha256Hex(frame, frame_buffer.length) == manifest.sha256;
+    if (!success) {
+        ESP_LOGW(kTag, "Frame validation failed; keeping previous frame");
+        free(frame);
+        return false;
+    }
+    success = SaveFrame(frame, manifest);
+    free(frame);
+    if (!success) {
+        ESP_LOGW(kTag, "Frame storage failed; revision not advanced");
+        return false;
+    }
+
+    {
+        Settings writable(kNamespace, true);
+        writable.SetString(kRevisionKey, manifest.revision);
+    }
+    s_session_revision = manifest.revision;
+    ESP_LOGI(kTag, "Stored verified frame revision=%.12s", manifest.revision.c_str());
+    if (s_on_frame_ready) s_on_frame_ready();
+    return true;
+}
+
+void Worker(void*) {
+    int seconds_until_poll = 0;
+    while (true) {
+        if (!s_connected.load(std::memory_order_acquire)) {
+            seconds_until_poll = 0;
+            vTaskDelay(pdMS_TO_TICKS(1000));
+            continue;
+        }
+        const bool requested = s_sync_requested.exchange(false, std::memory_order_acq_rel);
+        if (!requested && seconds_until_poll > 0) {
+            --seconds_until_poll;
+            vTaskDelay(pdMS_TO_TICKS(1000));
+            continue;
+        }
+
+        const ClientConfig config = LoadConfig();
+        seconds_until_poll = config.poll_minutes * 60;
+        if (!config.enabled) {
+            seconds_until_poll = 5;
+        } else if (!IsSafeHttpsBaseUrl(config.base_url) || config.username.empty() || config.password.empty()) {
+            ESP_LOGW(kTag, "Dashboard config incomplete; HTTPS URL, username and password are required");
+            seconds_until_poll = 30;
+        } else if (time(nullptr) < 1735689600) {
+            // Certificate validation needs a sane wall clock. SNTP starts on
+            // the same Wi-Fi event, so wait briefly instead of treating first
+            // boot as a network failure.
+            ESP_LOGI(kTag, "Waiting for SNTP before HTTPS quota sync");
+            seconds_until_poll = 5;
+        } else {
+            SyncOnce(config);
+        }
+        vTaskDelay(pdMS_TO_TICKS(1000));
+    }
+}
+
+}  // namespace
+
+void codex_quota_client_start(std::function<void()> on_frame_ready) {
+    s_on_frame_ready = std::move(on_frame_ready);
+    if (s_started.exchange(true, std::memory_order_acq_rel)) return;
+    BaseType_t result = xTaskCreate(Worker, "codex_quota", 8192, nullptr, 4, nullptr);
+    if (result != pdPASS) {
+        s_started.store(false, std::memory_order_release);
+        ESP_LOGE(kTag, "Failed to create quota sync task");
+    }
+}
+
+void codex_quota_client_set_connected(bool connected) {
+    s_connected.store(connected, std::memory_order_release);
+    if (connected) s_sync_requested.store(true, std::memory_order_release);
+}
+
+void codex_quota_client_request_sync() {
+    s_sync_requested.store(true, std::memory_order_release);
+}
